{
    "name": "@cube/graphic-walker-embed",
    "version": "0.1.0",
    "description": "Framework-agnostic Graphic Walker host API for Cube Front (Vue) and other embeddings",
    "type": "module",
    "license": "Apache-2.0",
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./contract": {
            "types": "./dist/contract.d.ts",
            "import": "./dist/contract.js"
        }
    },
    "files": [
        "dist"
    ],
    "sideEffects": false,
    "scripts": {
        "build": "vite build && tsc --emitDeclarationOnly --declaration --declarationDir dist",
        "test": "jest",
        "typecheck": "tsc --noEmit"
    },
    "publishConfig": {
        "registry": "https://snr.promit-ek.ru/repository/cube.npm-hosted/"
    },
    "peerDependencies": {
        "react": ">=19.0.0",
        "react-dom": ">=19.0.0"
    },
    "dependencies": {
        "@kanaries/duckdb-computation": "0.0.1",
        "@kanaries/graphic-walker": "0.5.2"
    },
    "devDependencies": {
        "@types/jest": "^29.5.3",
        "@types/react": "^19.2.17",
        "@types/react-dom": "^19.2.3",
        "@vitejs/plugin-react": "^4.2.0",
        "jest": "^29.6.2",
        "ts-jest": "^29.1.1",
        "typescript": "^5.2.2",
        "vite": "^5.0.0"
    }
}
